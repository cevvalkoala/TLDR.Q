{
  "manifest_version": 3,
  "incognito": "not_allowed",
  "name": "TLDR.Q",
  "version": "1.0.0",
  "description": "Summarize the current page using your chosen AI provider.",
  "homepage_url": "https://github.com/cevvalkoala/TLDR.Q",
  "icons": { "16": "src/icon-16.png", "32": "src/icon-32.png", "48": "src/icon-48.png", "64": "src/icon-64.png", "128": "src/icon-128.png" },
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": { "default_title": "Open TLDR.Q and summarize this page", "default_icon": { "16": "src/icon-16.png", "32": "src/icon-32.png", "48": "src/icon-48.png", "64": "src/icon-64.png", "128": "src/icon-128.png" } },
  "sidebar_action": { "default_title": "TLDR.Q", "default_panel": "src/sidebar.html", "default_icon": { "16": "src/icon-16.png", "32": "src/icon-32.png", "48": "src/icon-48.png", "64": "src/icon-64.png", "128": "src/icon-128.png" }, "open_at_install": false },
  "options_ui": { "page": "src/options.html", "open_in_tab": true },
  "commands": {
    "summarize": { "suggested_key": { "default": "Alt+Shift+Q" }, "description": "Open TLDR.Q and summarize the current page" }
  },
  "background": { "scripts": ["src/providers.js", "src/background.js"] },
  "browser_specific_settings": { "gecko": { "id": "ai-based-summaries@tldrq.local", "strict_min_version": "140.0", "data_collection_permissions": { "required": ["websiteContent"], "optional": ["authenticationInfo"] } } }
}
